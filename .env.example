# Copy to .env and fill in real values. Never commit .env itself.
# Full description of every variable: DEPLOYMENT.md.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme-root-password
MYSQL_DATABASE=asnan
MYSQL_USER=asnan
MYSQL_PASSWORD=changeme-app-password

# --- API: environment ---
# Development boots with Mock OTP/payment providers (see DEPLOYMENT.md).
# Any real deployment must set this to Production.
ASPNETCORE_ENVIRONMENT=Development

# --- API: JWT ---
JWT_ISSUER=asnan-api
JWT_AUDIENCE=asnan-app
# Any random string of 32+ characters. Rotating this invalidates every
# issued access/refresh token.
JWT_SIGNING_KEY=changeme-generate-a-real-random-32-plus-char-key

# --- API: OTP ---
# HMAC key used to hash stored OTP codes — never the code itself in cleartext.
OTP_HASHING_KEY=changeme-generate-a-real-random-key
# "Mock" (default, Development-only) or a real provider name once #41 is
# configured.
OTP_PROVIDER_EMAIL=Mock
OTP_PROVIDER_SMS=Mock

# --- API: CORS ---
# The Flutter web target's (or an admin web app's) origin. Leave unset for
# API-only mobile deployments — native clients aren't subject to CORS.
CORS_ALLOWED_ORIGIN_0=

# --- API: Payments ---
# "Mock" (default, Development-only) or a real provider name once #41/#60
# are configured.
PAYMENT_PROVIDER=Mock
# Only required when PAYMENT_PROVIDER=Mock.
PAYMENT_MOCK_WEBHOOK_SIGNING_KEY=changeme-generate-a-real-random-key

# --- API: Push notifications ---
# Empty/unset uses the no-op sender (logs instead of pushing — always safe).
# Set to "Fcm" once #71 is configured, and provide the credentials below.
NOTIFICATION_PROVIDER=
NOTIFICATION_FCM_CREDENTIALS_JSON=
